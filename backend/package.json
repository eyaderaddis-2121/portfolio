{
  "name": "portfolio-backend",
  "version": "1.0.0",
  "description": "Backend API for Eyaderaddis Belete Portfolio",
  "main": "api/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18.x"
  },
  "scripts": {
    "start":       "node src/server.js",
    "dev":         "nodemon src/server.js",
    "setup-admin": "node src/utils/setupAdmin.js",
    "build":       "echo 'No build step required for Node.js'"
  },
  "nodemonConfig": {
    "watch":  ["src"],
    "ext":    "js,json",
    "ignore": ["node_modules"],
    "delay":  500
  },
  "keywords": [],
  "author": "Eyaderaddis Belete",
  "license": "MIT",
  "dependencies": {
    "bcryptjs":           "^3.0.3",
    "cors":               "^2.8.6",
    "dotenv":             "^18.0.10",
    "express":            "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator":  "^7.0.1",
    "helmet":             "^7.1.0",
    "jsonwebtoken":       "^9.0.2",
    "mysql2":             "^3.6.5",
    "nodemailer":         "^6.9.7",
    "uuid":               "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
