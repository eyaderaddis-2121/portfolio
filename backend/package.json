{
  "name": "portfolio-backend",
  "version": "1.0.0",
  "description": "Backend API for Eyaderaddis Belete Portfolio",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start":       "node src/server.js",
    "dev":         "nodemon src/server.js",
    "setup-admin": "node src/utils/setupAdmin.js"
  },
  "nodemonConfig": {
    "watch":  ["src"],
    "ext":    "js,json",
    "ignore": ["node_modules"],
    "delay":  500
  },
  "keywords": [],
  "author": "Eyaderaddis Belete",
  "license": "MIT",
  "dependencies": {
    "bcryptjs":           "^3.0.3",
    "cors":               "^2.8.6",
    "dotenv":             "^18.0.10",
    "express":            "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "express-validator":  "^7.3.2",
    "helmet":             "^8.3.0",
    "jsonwebtoken":       "^9.0.3",
    "mysql2":             "^3.24.6",
    "nodemailer":         "^10.5.0",
    "nodemon":            "^3.1.14",
    "uuid":               "^14.0.3"
  }
}
