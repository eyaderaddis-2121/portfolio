PORT=5000
NODE_ENV=development

# MySQL Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=portfolio
DB_PORT=3306

# JWT
JWT_SECRET=generate_a_secure_random_secret_here_min_32_chars
JWT_EXPIRES_IN=7d

# Gmail SMTP (use Gmail App Password, NOT your real password)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password_16_chars
ADMIN_EMAIL=your_email@gmail.com

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:3000
