PORT=5000
NODE_ENV=production

# ── TiDB Cloud / MySQL ────────────────────────────────────────────
# Get these from: https://tidbcloud.com → your cluster → Connect
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_USER=your_tidb_username
DB_PASSWORD=your_tidb_password
DB_NAME=portfolio
DB_PORT=4000

# ── JWT ───────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=generate_a_secure_64_char_hex_secret_here
JWT_EXPIRES_IN=7d

# ── Gmail SMTP ────────────────────────────────────────────────────
# App Password from: https://myaccount.google.com/apppasswords
EMAIL_USER=Eyaderaddisbelete@gmail.com
EMAIL_PASS=your_16_char_gmail_app_password
ADMIN_EMAIL=Eyaderaddisbelete@gmail.com

# ── CORS ─────────────────────────────────────────────────────────
# Your deployed frontend Vercel URL (comma-separate multiple URLs)
CLIENT_URL=https://your-portfolio.vercel.app
